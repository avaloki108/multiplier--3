{
  "name": "@multiplier/solidity",
  "version": "2.0.0",
  "description": "Multiplier provides precise and comprehensive code understanding capabilities for Solidity smart contracts",
  "main": "index.js",
  "scripts": {
    "build": "npm run compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'"
  },
  "keywords": [
    "solidity",
    "smart-contracts",
    "ethereum",
    "blockchain",
    "analysis",
    "security",
    "audit"
  ],
  "author": "Trail of Bits",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trailofbits/multiplier"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
